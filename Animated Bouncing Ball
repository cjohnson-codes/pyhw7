from graphics import *
from time import sleep

def main():

    startHeight = float(input("Enter release height in meters: "))

    win = GraphWin("Bouncing Ball", 400, 600)
    win.setCoords(0, 0, 10, startHeight + 1)

    ball = Circle(Point(5, startHeight), 0.2)
    ball.setFill("red")
    ball.draw(win)

    height = startHeight

    while height >= 0.001:

        # Move to ground
        ball.move(0, -height)
        sleep(0.3)

        height *= 0.60

        # Move to new bounce height
        ball.move(0, height)
        sleep(0.3)

    Text(Point(5, startHeight/2), "Done").draw(win)

    win.getMouse()
    win.close()

main()